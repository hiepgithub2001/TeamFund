{
	# nginx on this server already uses port 80, so certificates are issued
	# through the TLS-ALPN challenge on port 443 only.
	auto_https disable_redirects
}

{$PUBLIC_HOST} {
	log {
		output stdout
		format console
	}

	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# Telegram updates for the master bot and every team bot,
	# SePay webhooks (one URL per team), and the health check
	# Services like SePay check a URL by opening it (GET) before they accept it.
	# Answer those visits with 200; the real webhook calls are POSTs.
	@probe {
		method GET HEAD
		path / /sepay/*
	}
	handle @probe {
		respond "Team Fund is running." 200
	}

	# /p/*: the teams' pay pages for members without Telegram (secret link per team)
	@public path /tg/* /sepay/* /health /p/*
	handle @public {
		reverse_proxy app:8000
	}

	# Nothing else is public.
	handle {
		respond 404
	}
}
